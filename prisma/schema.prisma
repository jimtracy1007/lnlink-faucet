generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FaucetRecord {
  id           Int      @id @default(autoincrement())
  nostrAddress String   @map("nostr_address")
  claimTime    DateTime @default(now()) @map("claim_time")
  amount       Float
  status       String   // pending, success, failed
  assetType    String   @map("asset_type") // btc, taproot, rgb
  assetId      String   @map("asset_id")
  assetName    String?  @map("asset_name")
  txHash       String?  @map("tx_hash")
  invoice      String?  // invoice or address
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([nostrAddress, claimTime])
  @@map("faucet_records")
}

model TaskDefinition {
  id          Int           @id @default(autoincrement())
  tag         String        @unique
  displayName String        @map("display_name")
  category    String        @map("category")
  description String?
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  completions TaskCompletion[]

  @@index([category, isActive])
  @@map("task_definitions")
}

model TaskCompletion {
  id           Int             @id @default(autoincrement())
  taskId       Int             @map("task_id")
  nostrAddress String          @map("nostr_address")
  completedAt  DateTime        @default(now()) @map("completed_at")
  meta         String?         @map("meta")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  task         TaskDefinition  @relation(fields: [taskId], references: [id])

  @@unique([taskId, nostrAddress])
  @@index([nostrAddress])
  @@map("task_completions")
}

model LnlinkIdentity {
  id           Int      @id @default(autoincrement())
  nostrAddress String   @unique @map("nostr_address")
  lnlinkNpub   String   @unique @map("lnlink_npub")
  nodeType     String?  @map("node_type")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("lnlink_identities")
}
